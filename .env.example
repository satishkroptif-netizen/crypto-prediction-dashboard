# Email OTP via Resend — copy to .env.local and fill in
RESEND_API_KEY=re_your_key_here
# Sender must use a domain verified at resend.com/domains
OTP_FROM=GnC Signal <noreply@yourdomain.com>

# Verified-signup leads (name, email, phone, timestamp) — optional, both can be set
# 1) Google Sheet via Apps Script webhook (works on Vercel) — paste your web-app URL
SHEET_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbyAbiYlwL1Nj5DPo4g73876etODAhZYvhHw-waKjP7wzbXno8omsg9-2t22znEjMJqC/exec
# 2) Local CSV on the server disk (SELF-HOSTED ONLY — Vercel's disk is ephemeral)
# LEADS_CSV_PATH=./data/leads.csv
